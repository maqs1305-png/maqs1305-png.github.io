# Настройки сервера reg.ru (Apache) для kvrtr9.ru – 21.10.2026.
# Перевод с http на https включаем в панели хостинга и проверяем после выкладки – так нет риска зациклить переадресацию.

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # www.kvrtr9.ru → kvrtr9.ru (один адрес сайта для поиска)
  RewriteCond %{HTTP_HOST} ^www\.kvrtr9\.ru$ [NC]
  RewriteRule ^(.*)$ https://kvrtr9.ru/$1 [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # файлы в /_astro/ меняют имя при каждой правке – их можно хранить у посетителя год
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    ExpiresDefault "access plus 1 year"
    <IfModule mod_headers.c>
      Header set Cache-Control "public, max-age=31536000, immutable"
    </IfModule>
  </If>
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  # страницы – всегда свежие: правки афиши видны сразу
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
